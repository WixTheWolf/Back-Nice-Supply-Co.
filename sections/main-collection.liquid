<section class="shell section">
  <header class="collection-head"><p class="eyebrow">Collection</p><h1>{{ collection.title }}</h1><p>{{ collection.description }}</p></header>
  <form class="sort-form" method="get"><label for="sort-by">Sort</label><select id="sort-by" name="sort_by" onchange="this.form.submit()">{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></form>
  <div class="product-grid">{% for product in collection.products %}<article class="product-card"><a href="{{ product.url }}">{{ product.featured_image | image_url: width: 900 | image_tag }}<h3>{{ product.title }}</h3><p>{{ product.price | money }}</p></a></article>{% endfor %}</div>
</section>
{% schema %}{"name":"Main collection","settings":[]}{% endschema %}
