<section class="shell section"><h2>{{ section.settings.title }}</h2><p>{{ section.settings.text }}</p><div class="swatches">{% for block in section.blocks %}<div><span class="swatch" style="background:{{ block.settings.color }}"></span><small>{{ block.settings.label }}</small></div>{% endfor %}</div></section>
{% schema %}{"name":"Palette","settings":[{"type":"text","id":"title","default":"Earth, ocean, sand, sky. The best color palette of all.","label":"Title"},{"type":"text","id":"text","default":"A restrained palette built for everyday wear.","label":"Text"}],"blocks":[{"type":"swatch","name":"Swatch","settings":[{"type":"text","id":"label","label":"Label"},{"type":"color","id":"color","label":"Color"}]}],"presets":[{"name":"Palette","blocks":[{"type":"swatch","settings":{"label":"Cream","color":"#F4EBDD"}},{"type":"swatch","settings":{"label":"Espresso","color":"#5C3F2A"}},{"type":"swatch","settings":{"label":"Sage","color":"#8B967F"}},{"type":"swatch","settings":{"label":"Coastal Blue","color":"#4F6D7A"}},{"type":"swatch","settings":{"label":"Navy","color":"#1D2633"}},{"type":"swatch","settings":{"label":"Charcoal","color":"#2E3133"}},{"type":"swatch","settings":{"label":"Black","color":"#111111"}}]}]}{% endschema %}
