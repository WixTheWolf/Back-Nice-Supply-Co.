<section class="shell section email"><h2>{{ section.settings.title }}</h2><p>{{ section.settings.text }}</p>{% form 'customer' %}<input type="email" name="contact[email]" placeholder="Enter your email" required><button class="btn" type="submit">{{ section.settings.button }}</button>{% endform %}</section>
{% schema %}{"name":"Email capture","settings":[{"type":"text","id":"title","default":"Join the Clubhouse.","label":"Title"},{"type":"text","id":"text","default":"Early access to new drops, private offers, and field notes from the Back Nine.","label":"Text"},{"type":"text","id":"button","default":"Get Early Access","label":"Button"}]}{% endschema %}
