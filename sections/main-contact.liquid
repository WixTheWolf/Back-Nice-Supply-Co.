<section class="shell section page-content"><h1>{{ page.title }}</h1><p>Questions, wholesale, collaborations, or clubhouse notes? Send us a message.</p>{% form 'contact' %}<input type="text" name="contact[name]" placeholder="Name" required><input type="email" name="contact[email]" placeholder="Email" required><textarea name="contact[body]" placeholder="Message" required></textarea><button class="btn" type="submit">Send message</button>{% endform %}</section>
{% schema %}{"name":"Main contact","settings":[]}{% endschema %}
