<section class="shell section product-layout">
  <div>{{ product.featured_image | image_url: width: 1400 | image_tag }}</div>
  <aside class="purchase-panel"><p class="eyebrow">{{ product.vendor }}</p><h1>{{ product.title }}</h1><p>{{ product.price | money }}</p><p>{{ section.settings.sample_copy }}</p>
  {% form 'product', product %}{% if product.has_only_default_variant == false %}{% for option in product.options_with_values %}<label>{{ option.name }}</label><select name="options[{{ option.name | escape }}]">{% for value in option.values %}<option>{{ value }}</option>{% endfor %}</select>{% endfor %}{% endif %}<button class="btn" type="submit">Add to cart</button>{% endform %}
  <div class="accordion"><details open><summary>Fit notes</summary><p>{{ section.settings.fit_notes }}</p></details><details><summary>Fabric notes</summary><p>{{ section.settings.fabric_notes }}</p></details><details><summary>Care instructions</summary><p>{{ section.settings.care_notes }}</p></details><details><summary>Shipping & returns</summary><p>{{ section.settings.shipping_notes }}</p></details></div>
  <ul class="built-for"><li>4-way stretch</li><li>breathable performance</li><li>soft hand feel</li><li>UPF 50+</li><li>moisture wicking</li></ul></aside>
</section>
{% schema %}{"name":"Main product","settings":[{"type":"textarea","id":"sample_copy","label":"Product intro","default":"The Heritage Stripe Polo brings vintage golf energy into a cleaner modern fit. Lightweight, breathable, and sharp enough to wear long after the scorecard disappears."},{"type":"textarea","id":"fit_notes","label":"Fit notes","default":"Tailored athletic fit. True to size."},{"type":"textarea","id":"fabric_notes","label":"Fabric notes","default":"Lightweight performance knit with soft hand feel."},{"type":"textarea","id":"care_notes","label":"Care notes","default":"Machine wash cold. Hang dry."},{"type":"textarea","id":"shipping_notes","label":"Shipping/returns","default":"Free shipping over $100. 30-day returns."}]}{% endschema %}
